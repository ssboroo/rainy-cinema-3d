NODE_ENV=development
PORT=3001
HOST=0.0.0.0
DATABASE_URL=postgresql://postgres:password@localhost:5432/rainy_cinema
DATABASE_SSL=false
JWT_SECRET=replace-with-at-least-32-random-characters
CORS_ORIGINS=http://localhost:5173
DB_POOL_MAX=10
TRUST_PROXY=false
BOOTSTRAP_TENANT_NAME=Demo Cinema Group
BOOTSTRAP_TENANT_SLUG=demo-cinema
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-unique-16-character-or-longer-password

# Cinema integrations (server-side secrets only)
# Vista Connect (Urgoo's published API docs use this base path; obtain a partner API token and cinema ID first)
VISTA_CONNECT_BASE_URL=https://booking.urgoo.mn/WSVistaWebClient
VISTA_CONNECT_API_TOKEN=
VISTA_CONNECT_CINEMA_ID=
VISTA_CONNECT_REGION_CODE=
VISTA_CONNECT_TIMEOUT_MS=10000
# For multiple Vista circuits, use a JSON array in Railway Variables; keep API tokens here, never in the browser.
# CINEMA_PROVIDERS_JSON=[{"id":"urgoo","provider":"vista-connect","baseUrl":"https://booking.urgoo.mn/WSVistaWebClient","apiToken":"<secret>","cinemaId":"<cinema-id>","regionCode":"MN"}]
